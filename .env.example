# --- Datenbank ---------------------------------------------------------------
POSTGRES_USER=azubiportal
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=azubiportal
POSTGRES_PORT=5433
DATABASE_URL=postgres://azubiportal:bitte-aendern@localhost:5433/azubiportal

# --- Auth.js / Microsoft Entra ID -------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# Öffentliche Adresse der Anwendung
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# z.B. https://login.microsoftonline.com/<TENANT-ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Entwicklungs-Login ohne Entra ID. In Produktion wirkungslos.
DEV_LOGIN_ENABLED=true

# Beim allerersten Login: diese E-Mail-Adressen bekommen die Rolle ADMIN
BOOTSTRAP_ADMIN_EMAILS=

# --- Cron / Worker -----------------------------------------------------------
# openssl rand -hex 24
CRON_SECRET=
APP_BASE_URL=http://localhost:3000
REMINDER_CRON=0 7 * * 1-5
PLANNING_CRON=30 5 * * 1

# --- Container ---------------------------------------------------------------
# Migrationen beim Start ausführen (der Worker setzt das auf false)
RUN_MIGRATIONS=true
