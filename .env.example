# --- Datenbank ---------------------------------------------------------------
POSTGRES_USER=azubiportal
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=azubiportal
POSTGRES_PORT=5433
DATABASE_URL=postgres://azubiportal:bitte-aendern@localhost:5433/azubiportal

# --- Auth.js / Microsoft Entra ID -------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# Öffentliche Adresse der Anwendung
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Anwendungs-ID (client) aus der App-Registrierung
AUTH_MICROSOFT_ENTRA_ID_ID=
# Der WERT des Client-Geheimnisses, nicht dessen ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Mandanten-ID (GUID) oder die vollständige Adresse
# https://login.microsoftonline.com/<MANDANTEN-ID>/v2.0
# Leer lassen erlaubt jedes Microsoft-Konto.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Entwicklungs-Login ohne Entra ID. In Produktion wirkungslos.
DEV_LOGIN_ENABLED=true

# Nur Adressen dieser Domänen dürfen sich anmelden (kommagetrennt).
# Leer lassen heißt: keine Einschränkung durch die Anwendung.
ALLOWED_EMAIL_DOMAINS=

# Beim allerersten Login: diese E-Mail-Adressen bekommen die Rolle ADMIN
BOOTSTRAP_ADMIN_EMAILS=

# --- Cron / Worker -----------------------------------------------------------
# openssl rand -hex 24
CRON_SECRET=
APP_BASE_URL=http://localhost:3000
REMINDER_CRON=0 7 * * 1-5
PLANNING_CRON=30 5 * * 1

# --- Container ---------------------------------------------------------------
# Migrationen beim Start ausführen (der Worker setzt das auf false)
RUN_MIGRATIONS=true
